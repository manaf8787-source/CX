{
  "$description": "Measured from Framer text-style presets (desktop / tablet 810-1199 / phone <=809). Letter-spacing is in em, line-height is unitless.",
  "fontFamily": {
    "sans": "\"Plus Jakarta Sans\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "source": "Plus Jakarta Sans via Google Fonts (served by Framer from framerusercontent third-party-assets). Weights loaded: 400, 500, 600. 700 is declared for bold only and is never used in the UI."
  },
  "fontWeight": {
    "regular": 400,
    "medium": 500,
    "semibold": 600
  },
  "fontFeatureSettings": "\"blwf\" on, \"cv03\" on, \"cv04\" on, \"cv09\" on, \"cv11\" on",
  "rendering": {
    "-webkit-font-smoothing": "antialiased",
    "text-wrap (headings)": "balance"
  },
  "styles": {
    "display": {
      "fontSize": "72px",
      "fontWeight": 500,
      "letterSpacing": "-0.045em",
      "lineHeight": 1.08,
      "color": "{ink.primary}",
      "styleGuideName": "Display",
      "usedFor": "Marketing H1 only",
      "source": "measured",
      "tablet": "56px",
      "phone": "40px"
    },
    "h2": {
      "fontSize": "52px",
      "fontWeight": 500,
      "letterSpacing": "-0.035em",
      "lineHeight": 1.08,
      "color": "{ink.primary}",
      "styleGuideName": "Heading 2",
      "usedFor": "Marketing section titles",
      "source": "measured",
      "tablet": "42px",
      "phone": "32px"
    },
    "stat": {
      "fontSize": "56px",
      "fontWeight": 500,
      "letterSpacing": "-0.05em",
      "lineHeight": 1.0,
      "color": "{ink.primary}",
      "styleGuideName": "(stat number)",
      "usedFor": "Hero statistic number (11.5, 0.8)",
      "source": "measured"
    },
    "price": {
      "fontSize": "44px",
      "fontWeight": 500,
      "letterSpacing": "-0.05em",
      "lineHeight": 1.0,
      "color": "{ink.primary}",
      "styleGuideName": "Price",
      "usedFor": "Price / large KPI value",
      "source": "measured"
    },
    "h3": {
      "fontSize": "24px",
      "fontWeight": 500,
      "letterSpacing": "-0.03em",
      "lineHeight": 1.2,
      "color": "{ink.primary}",
      "styleGuideName": "Heading 3",
      "usedFor": "Card titles, stat unit suffix, document H2",
      "source": "measured",
      "tablet": "22px",
      "phone": "20px"
    },
    "cardTitle": {
      "fontSize": "22px",
      "fontWeight": 500,
      "letterSpacing": "-0.035em",
      "lineHeight": 1.1,
      "color": "{ink.primary}",
      "styleGuideName": "Card Title",
      "usedFor": "Bento card titles",
      "source": "measured"
    },
    "wordmark": {
